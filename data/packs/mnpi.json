  "templates": {
    "ar": {
      "accountability": "المراجع: {reviewer}. مدة الاحتفاظ: {retention}. المستلم: {recipient}.",
      "brief": "يطلب {requester} {what} من {deployment}. {delta} يحتوي على {direct_count} معرّف(ات) مباشرة، حجب النظام منها {masked_count}، و{freetext_count} حقل(حقول) نص حر لم يحجبها. سيكشف هذا الإفراج عن {below_threshold} سجل(سجلات) دون الحد الأدنى. لن يخرج أي شيء آخر من {deployment}. إذا وافقت، يحتفظ به {recipient} لمدة {retention} ويجب أن يعيد إثبات الإتلاف. أنت توقّع بصفتك {reviewer}.",
      "delta_new": "لا يوجد إفراج سابق مماثل؛ هذا شكل جديد.",
      "delta_same": "له الشكل نفسه للإفراج الذي أجزته في {prior_date}، مع تغيّر {changed} قيمة/قيم.",
      "does_not_stop": "ما لا تمنعه هذه الدرجة: {clause}",
      "gate_fail": "تمنع القاعدة {gate} هذا الإفراج: {detail}. {remedy}",
      "reject_hint": "الرفض لا يحتاج إلى سبب. الموافقة فوق المستوى الأساسي تحتاج إلى سبب مكتوب بكلماتك.",
      "verdict_hidden": "حكم الآلة مختوم تحت الالتزام {commitment} وسيُعرض بعد أن تقرّر."
    },
    "en": {
      "accountability": "Reviewer: {reviewer}. Retention: {retention}. Recipient: {recipient}.",
      "brief": "{requester} is asking for {what} from {deployment}. {delta} It contains {direct_count} direct identifier(s), of which {masked_count} the system has already masked, and {freetext_count} free-text field(s), which it has not. This release would expose {below_threshold} record(s) below the threshold. Nothing else from {deployment} would leave. If you approve it, {recipient} holds it for {retention} and must return proof of destruction. You are signing as {reviewer}.",
      "delta_new": "There is no comparable earlier release; this is a new shape.",
      "delta_same": "It is the same shape as the release you cleared on {prior_date}, with {changed} value(s) changed.",
      "does_not_stop": "What this grade does not stop: {clause}",
      "gate_fail": "Rule {gate} blocks this release: {detail}. {remedy}",
      "reject_hint": "Rejecting needs no reason. Approving above the baseline tier needs your own typed reason.",
      "verdict_hidden": "The machine's finding is sealed under commitment {commitment} and will be shown after you decide."
    }
  },
