{
 "skill": "refunds-by-category-week",
 "version": "1.0.0",
 "author": "omar.h@vendor.example",
 "runtime": "sql",
 "inputs": [
  {
   "store": "orders",
   "fields": [
    "order_id",
    "district",
    "age_band",
    "city",
    "category",
    "channel",
    "week",
    "refund",
    "sentiment",
    "topic",
    "error_code"
   ]
  }
 ],
 "sql": "SELECT category, week, SUM(refund) AS refund_count FROM orders GROUP BY category, week HAVING COUNT(*) >= 10",
 "params": [],
 "output_schema": {
  "columns": [
   {
    "name": "category",
    "class": "STRUCTURAL",
    "type": "enum",
    "domain": [
     "electronics",
     "fashion",
     "grocery",
     "home",
     "beauty",
     "toys"
    ],
    "load_bearing": true
   },
   {
    "name": "week",
    "class": "QUASI",
    "type": "enum",
    "domain": [
     "2026-W22",
     "2026-W23",
     "2026-W24",
     "2026-W25",
     "2026-W26",
     "2026-W27",
     "2026-W28",
     "2026-W29",
     "2026-W30",
     "2026-W31",
     "2026-W32",
     "2026-W33",
     "2026-W34",
     "2026-W35",
     "2026-W36",
     "2026-W37"
    ],
    "transform": "coarsen",
    "params": {
     "granularity": "week",
     "kind": "time"
    }
   },
   {
    "name": "refund_count",
    "class": "STRUCTURAL",
    "type": "integer",
    "min": 0,
    "max": 100000,
    "transform": "aggregate",
    "params": {
     "min_cell": 10
    },
    "load_bearing": true
   }
  ],
  "max_rows": 200
 },
 "answers": [
  "service-health",
  "adoption"
 ],
 "declares": {
  "max_rows": 200,
  "no_freetext": true,
  "disjoint_strata": true
 },
 "description": "refunds per product category per week (counts, cells below 10 suppressed)",
 "description_ar": "المبالغ المستردة لكل فئة منتج في كل أسبوع (أعداد، خلايا أقل من 10 محذوفة)"
}
