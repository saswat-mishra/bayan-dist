{
 "skill": "weekly-usage-summary",
 "version": "1.0.0",
 "author": "priya.n@vendor.example",
 "runtime": "sql",
 "inputs": [
  {
   "store": "fingerprints",
   "fields": [
    "record_id",
    "ts_hour",
    "week",
    "tier",
    "operation",
    "topic",
    "route",
    "finish_reason",
    "error_code",
    "latency_bucket",
    "input_bucket",
    "output_bucket",
    "hit_count",
    "doc_ref_count",
    "index_generation"
   ]
  }
 ],
 "sql": "SELECT week, topic, COUNT(*) AS request_count FROM fingerprints WHERE topic IS NOT NULL GROUP BY week, topic HAVING COUNT(*) >= 10",
 "params": [],
 "output_schema": {
  "columns": [
   {
    "name": "week",
    "class": "QUASI",
    "type": "enum",
    "domain": [
     "2026-W22",
     "2026-W23",
     "2026-W24",
     "2026-W25",
     "2026-W26",
     "2026-W27",
     "2026-W28",
     "2026-W29",
     "2026-W30",
     "2026-W31",
     "2026-W32",
     "2026-W33",
     "2026-W34",
     "2026-W35",
     "2026-W36",
     "2026-W37"
    ],
    "transform": "coarsen",
    "params": {
     "granularity": "week",
     "kind": "time"
    }
   },
   {
    "name": "topic",
    "class": "STRUCTURAL",
    "type": "enum",
    "domain": [
     "pension",
     "leave",
     "payroll",
     "it-access",
     "housing",
     "medical-insurance",
     "training"
    ]
   },
   {
    "name": "request_count",
    "class": "STRUCTURAL",
    "type": "integer",
    "min": 10,
    "max": 1000000,
    "transform": "aggregate",
    "params": {
     "min_cell": 10
    },
    "load_bearing": true
   }
  ],
  "max_rows": 500
 },
 "answers": [
  "adoption",
  "quality-regression"
 ],
 "declares": {
  "max_rows": 500,
  "no_freetext": true,
  "disjoint_strata": true
 },
 "description": "weekly usage by topic — the acceptance-evidence summary",
 "description_ar": "الاستخدام الأسبوعي حسب الموضوع — ملخص أدلة القبول"
}
