    "transform": "hmac_enclave",
    "tags": [
     "part2"
    ]
   },
   {
    "name": "week",
    "class": "QUASI",
    "type": "enum",
    "domain": [
     "2026-W22",
     "2026-W23",
     "2026-W24",
     "2026-W25",
     "2026-W26",
     "2026-W27",
     "2026-W28",
     "2026-W29",
     "2026-W30",
     "2026-W31",
     "2026-W32",
     "2026-W33",
     "2026-W34",
     "2026-W35",
     "2026-W36",
     "2026-W37"
    ],
    "transform": "coarsen",
    "params": {
