{
 "skill": "sud-program-utilisation",
 "version": "1.0.0",
 "author": "omar.h@vendor.example",
 "runtime": "sql",
 "inputs": [
  {
   "store": "appointments",
   "fields": [
    "specialty",
    "week",
    "no_show",
    "clinic_id",
    "diagnosis_code",
    "sud_program_id",
    "error_code"
   ]
  }
 ],
 "sql": "SELECT sud_program_id, week, COUNT(*) AS visit_count FROM appointments WHERE sud_program_id IS NOT NULL GROUP BY sud_program_id, week HAVING COUNT(*) >= 1",
