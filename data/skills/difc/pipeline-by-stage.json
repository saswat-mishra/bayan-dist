{
 "skill": "pipeline-by-stage",
 "version": "1.0.0",
 "author": "omar.h@vendor.example",
 "runtime": "sql",
 "inputs": [
  {
   "store": "deal_desk",
   "fields": [
    "stage",
    "week",
    "counterparty_name",
    "deal_codename",
    "deal_status",
    "sector",
    "error_code"
   ]
  }
 ],
 "sql": "SELECT stage, week, COUNT(*) AS deal_count FROM deal_desk WHERE error_code != 'none' GROUP BY stage, week HAVING COUNT(*) >= 5",
 "params": [],
 "output_schema": {
  "columns": [
   {
    "name": "stage",
    "class": "STRUCTURAL",
    "type": "enum",
    "domain": [
     "nda",
     "diligence",
     "term-sheet",
     "signing",
     "closing"
    ]
   },
   {
    "name": "week",
    "class": "QUASI",
    "type": "enum",
    "domain": [
     "2026-W22",
     "2026-W23",
     "2026-W24",
     "2026-W25",
     "2026-W26",
     "2026-W27",
     "2026-W28",
     "2026-W29",
     "2026-W30",
     "2026-W31",
     "2026-W32",
     "2026-W33",
     "2026-W34",
     "2026-W35",
     "2026-W36",
     "2026-W37"
    ],
    "transform": "coarsen",
    "params": {
     "granularity": "week",
     "kind": "time"
    }
   },
   {
    "name": "deal_count",
    "class": "STRUCTURAL",
    "type": "integer",
    "min": 5,
    "max": 100000,
    "transform": "aggregate",
    "params": {
     "min_cell": 5
    },
    "load_bearing": true
   }
  ],
  "max_rows": 200
 },
 "answers": [
  "service-health",
  "failing-stage"
 ],
 "declares": {
  "max_rows": 200,
  "no_freetext": true
 },
 "description": "failed contract-review answers per deal stage per week",
 "description_ar": "إجابات مراجعة العقود الفاشلة لكل مرحلة صفقة في كل أسبوع"
}
