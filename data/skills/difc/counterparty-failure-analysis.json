{
 "skill": "counterparty-failure-analysis",
 "version": "1.0.0",
 "author": "omar.h@vendor.example",
 "runtime": "sql",
 "inputs": [
  {
   "store": "deal_desk",
   "fields": [
    "stage",
    "week",
    "counterparty_name",
    "deal_codename",
    "deal_status",
    "sector",
    "error_code"
   ]
  }
 ],
 "sql": "SELECT counterparty_name, stage, COUNT(*) AS deal_count FROM deal_desk WHERE error_code != 'none' GROUP BY counterparty_name, stage HAVING COUNT(*) >= 5",
