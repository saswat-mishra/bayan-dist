{
 "skill": "requests-by-topic-week",
 "version": "1.0.0",
 "author": "omar.h@vendor.example",
 "runtime": "sql",
 "inputs": [
  {
   "store": "stays",
   "fields": [
    "loyalty_tier",
    "room_type",
    "booking_week",
    "property",
    "request_topic",
    "resolved",
    "satisfaction",
    "error_code"
   ]
  }
 ],
 "sql": "SELECT request_topic, booking_week, COUNT(*) AS request_count FROM stays GROUP BY request_topic, booking_week HAVING COUNT(*) >= 10",
 "params": [],
 "output_schema": {
  "columns": [
   {
    "name": "request_topic",
    "class": "STRUCTURAL",
    "type": "enum",
    "domain": [
     "late-checkout",
     "room-service",
     "spa",
     "transport",
     "billing",
     "housekeeping",
     "wifi"
    ],
    "load_bearing": true
   },
   {
    "name": "booking_week",
    "class": "QUASI",
    "type": "enum",
    "domain": [
     "2026-W22",
     "2026-W23",
     "2026-W24",
     "2026-W25",
     "2026-W26",
     "2026-W27",
     "2026-W28",
     "2026-W29",
     "2026-W30",
     "2026-W31",
     "2026-W32",
     "2026-W33",
     "2026-W34",
     "2026-W35",
     "2026-W36",
     "2026-W37"
    ],
    "transform": "coarsen",
    "params": {
     "granularity": "week",
     "kind": "time"
    }
   },
   {
    "name": "request_count",
    "class": "STRUCTURAL",
    "type": "integer",
    "min": 10,
    "max": 1000000,
    "transform": "aggregate",
    "params": {
     "min_cell": 10
    },
    "load_bearing": true
   }
  ],
  "max_rows": 300
 },
 "answers": [
  "service-health",
  "adoption",
  "quality-regression"
 ],
 "declares": {
  "max_rows": 300,
  "no_freetext": true,
  "disjoint_strata": true
 },
 "description": "guest requests per topic per week (counts, cells below 10 suppressed)",
 "description_ar": "طلبات النزلاء لكل موضوع في كل أسبوع (أعداد، خلايا أقل من 10 محذوفة)"
}
