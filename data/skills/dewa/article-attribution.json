  "columns": [
   {
    "name": "doc_id",
    "class": "QUASI",
    "type": "enum",
    "domain": [
     "DEWA-BILL-EXPLAINED-2025-01",
     "DEWA-SLAB-TARIFF-2024-01",
     "DEWA-METER-READING-2024-06",
     "DEWA-SMART-METER-FAQ-2025-02",
     "DEWA-NEW-CONNECTION-2023-09",
     "DEWA-DISCONNECTION-NOTICE-2024-03",
     "DEWA-OUTAGE-REPORTING-2024-11",
     "DEWA-PAYMENT-CHANNELS-2025-01",
     "DEWA-AUTOPAY-2024-08",
     "DEWA-SECURITY-DEPOSIT-2023-05",
     "DEWA-GREEN-BILL-2024-02",
     "DEWA-EJARI-LINK-2024-10",
     "DEWA-TARIFF-CHANGE-2025-01",
     "DEWA-METER-DISPUTE-2024-06",
     "DEWA-MOVE-OUT-2023-12",
