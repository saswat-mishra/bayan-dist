   }
  ],
  "max_rows": 100
 },
 "answers": [
  "bad-documents",
  "index-regression"
 ],
 "declares": {
  "max_rows": 100,
  "no_freetext": true
 },
 "description": "which circulars are retrieved in failed answers (document IDENTITY)",
 "description_ar": "أي التعاميم تُسترجع في الإجابات الفاشلة (هوية المستند)"
}
