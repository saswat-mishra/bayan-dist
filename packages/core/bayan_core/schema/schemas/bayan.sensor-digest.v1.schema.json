{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bayan.dev/schemas/sensor-digest/v1",
  "type": "object",
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "additionalProperties": false,
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "digest": {
            "type": "object",
            "required": [
              "sha256"
            ],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "predicateType": {
      "const": "https://bayan.dev/sensor-digest/v1"
    },
    "predicate": {
      "type": "object",
      "required": [
        "deployment",
        "hour",
        "root",
        "events",
        "byClass",
        "dispositions",
        "honesty"
      ],
      "additionalProperties": false,
      "properties": {
        "deployment": {
          "type": "string"
        },
        "hour": {
          "type": "string",
          "pattern": "^\\\\d{4}-\\\\d{2}-\\\\d{2}T\\\\d{2}$"
        },
        "root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "byClass": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "MEDIA_MOUNT": {
              "type": "integer",
              "minimum": 0
            },
            "SCREEN_CAPTURE": {
              "type": "integer",
              "minimum": 0
            },
            "CLIPBOARD_EGRESS": {
              "type": "integer",
              "minimum": 0
            },
            "PRINT": {
              "type": "integer",
              "minimum": 0
            },
            "NET_EGRESS": {
              "type": "integer",
              "minimum": 0
            },
            "UNSANCTIONED_QUERY": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "dispositions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "logged": {
              "type": "integer",
              "minimum": 0
            },
            "blocked": {
              "type": "integer",
              "minimum": 0
            },
            "kill-switch": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "honesty": {
          "type": "string",
          "minLength": 20
        }
      }
    }
  }
}
