{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bayan.dev/schemas/release-request/v1",
  "title": "Bayan Release Request v1",
  "description": "What a requester seeks from inside a deployment boundary, why, and what they have already excluded. Carried as the base64 `payload` of a DSSE v1.0.2 envelope with payloadType `application/vnd.in-toto+json`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "predicateType": {
      "const": "https://bayan.dev/release-request/v1"
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment",
        "classification",
        "purpose",
        "mechanism",
        "minimisation",
        "budget",
        "retention",
        "requester"
      ],
      "properties": {
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "product",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "product": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "purpose": {
          "type": "string",
          "minLength": 20,
          "$comment": "The justification. Required by DCC 3-1-1-3 ('document all data sharing operations including the sharing justification'). A minimum length is imposed deliberately: a one-word purpose is not a justification."
        },
        "mechanism": {
          "type": "string",
          "enum": [
            "fingerprint",
            "output-check",
            "exemplar"
          ],
          "$comment": "The three mechanisms of PRD 1.2 B1. 'exemplar' can never be auto-cleared."
        },
        "query": {
          "type": "object",
          "additionalProperties": false,
          "$comment": "output-check only: the code that ran inside, bound by digest, never re-supplied at review time.",
          "required": [
            "digest",
            "language"
          ],
          "properties": {
            "digest": {
              "$ref": "#/$defs/digest"
            },
            "language": {
              "type": "string"
            },
            "runtime": {
              "type": "string"
            },
            "preCommittedSequenceId": {
              "type": "string",
              "$comment": "Set where the profile requires pre-commitment (PRD R-1.10). Binds this query to a sequence declared before any output was seen."
            }
          }
        },
        "minimisation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "droppedFields",
            "rationale"
          ],
          "$comment": "KSA Transfer Regulation Art 7(2)(d) requires evidence of the minimisation MECHANISM, not an assertion that minimisation occurred.",
          "properties": {
            "method": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "tier-projection",
                  "aggregation",
                  "hmac",
                  "bucketing",
                  "coarsening",
                  "masking",
                  "suppression"
                ]
              }
            },
            "droppedFields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "targetSensitivity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "rationale": {
              "type": "string",
              "minLength": 10
            }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "periodId",
            "consumedBefore",
            "requested",
            "periodLimit"
          ],
          "$comment": "Defence against adaptive/differencing attack (PRD 1.2 B3). No per-release check can detect a disclosive SEQUENCE; a budget bounds it and the ledger makes it auditable after the fact.",
          "properties": {
            "periodId": {
              "type": "string"
            },
            "consumedBefore": {
              "type": "integer",
              "minimum": 0
            },
            "requested": {
              "type": "integer",
              "minimum": 1
            },
            "periodLimit": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "period",
            "disposalMethod"
          ],
          "properties": {
            "period": {
              "type": "string",
              "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+D)?$"
            },
            "disposalMethod": {
              "type": "string",
              "enum": [
                "nist-800-88-clear",
                "nist-800-88-purge",
                "nist-800-88-destroy",
                "crypto-erase"
              ]
            }
          }
        },
        "requester": {
          "$ref": "#/$defs/identity"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sha512": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      }
    },
    "resourceDescriptor": {
      "$comment": "in-toto ResourceDescriptor. At least one of uri, digest, content. content SHOULD be <1KB.",
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "uri"
          ]
        },
        {
          "required": [
            "digest"
          ]
        },
        {
          "required": [
            "content"
          ]
        }
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "content": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "downloadLocation": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "keyid"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string"
        },
        "keyid": {
          "type": "string",
          "minLength": 1,
          "$comment": "Informational only. DSSE states keyid MUST NOT be used for security decisions; trust comes from signature verification against the trusted key set."
        },
        "role": {
          "type": "string",
          "$comment": "Profile-supplied role name, e.g. Authorizing Official. Never hard-coded."
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "tier",
        "basis"
      ],
      "properties": {
        "scheme": {
          "type": "string"
        },
        "tier": {
          "type": "string"
        },
        "sensitivity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "basis": {
          "type": "string",
          "enum": [
            "assigned",
            "inherited-from-system",
            "default-on-silence",
            "highest-in-set"
          ]
        }
      }
    }
  }
}