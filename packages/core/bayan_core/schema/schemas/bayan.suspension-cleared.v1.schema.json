{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bayan.dev/schemas/suspension-cleared/v1",
  "type": "object",
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "additionalProperties": false,
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "digest": {
            "type": "object",
            "required": [
              "sha256"
            ],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "predicateType": {
      "const": "https://bayan.dev/suspension-cleared/v1"
    },
    "predicate": {
      "type": "object",
      "required": [
        "deployment",
        "reason",
        "by",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "deployment": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 20
        },
        "by": {
          "type": "object",
          "required": [
            "id",
            "authority"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "authority": {
              "type": "string"
            },
            "keyid": {
              "type": "string"
            }
          }
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "event": {
          "type": "object",
          "required": [
            "digest"
          ],
          "properties": {
            "digest": {
              "type": "object",
              "required": [
                "sha256"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        "clears": {
          "type": "object",
          "required": [
            "leafIndex"
          ],
          "properties": {
            "leafIndex": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
