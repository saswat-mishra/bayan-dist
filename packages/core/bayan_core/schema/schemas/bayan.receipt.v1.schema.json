{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bayan.dev/schemas/receipt/v1",
  "title": "Bayan Receipt v1",
  "description": "What actually crossed the boundary, its position in the append-only register, and when it must be destroyed. Carried as the base64 `payload` of a DSSE v1.0.2 envelope with payloadType `application/vnd.in-toto+json`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "predicateType": {
      "const": "https://bayan.dev/receipt/v1"
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clearance",
        "released",
        "ledger",
        "egressPath",
        "retention"
      ],
      "properties": {
        "clearance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "digest"
          ],
          "properties": {
            "digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "released": {
          "type": "array",
          "minItems": 0,
          "$comment": "Exactly what crossed, by digest. An empty array is valid and meaningful: it records a request that was decided and released nothing.",
          "items": {
            "$ref": "#/$defs/resourceDescriptor"
          }
        },
        "ledger": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "checkpoint",
            "inclusionProof",
            "leafIndex"
          ],
          "properties": {
            "checkpoint": {
              "type": "string",
              "$comment": "C2SP tlog-checkpoint over signed-note: origin line, tree size, base64 RFC 6962 root hash, blank line, one or more signature lines. ~150 bytes of printable text; crosses an air gap on paper or as a printed code."
            },
            "leafIndex": {
              "type": "integer",
              "minimum": 0
            },
            "inclusionProof": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hashes"
              ],
              "properties": {
                "hashes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9+/=]+$"
                  }
                }
              }
            }
          }
        },
        "timestamp": {
          "type": "object",
          "additionalProperties": false,
          "$comment": "RFC 3161 token from a trusted TSA. Following Rekor v2, any integratedTime in a log response is always 0 and MUST be ignored; time comes from here.",
          "properties": {
            "rfc3161": {
              "type": "string",
              "contentEncoding": "base64"
            }
          }
        },
        "egressPath": {
          "type": "string",
          "enum": [
            "diode",
            "removable-media",
            "reviewed-manual",
            "allowlisted-push"
          ]
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "disposalDue",
            "disposalMethod"
          ],
          "properties": {
            "disposalDue": {
              "type": "string",
              "format": "date-time"
            },
            "disposalMethod": {
              "type": "string",
              "enum": [
                "nist-800-88-clear",
                "nist-800-88-purge",
                "nist-800-88-destroy",
                "crypto-erase"
              ]
            },
            "secondaryUse": {
              "const": "prohibited",
              "$comment": "PRD R-P11. Not profile-variable. Training, benchmarking and product analytics are foreclosed. SAMA CSF 3.4.3(4)(c)(1)."
            }
          }
        },
        "disposalAttestation": {
          "type": "object",
          "additionalProperties": false,
          "$comment": "Written back after destruction. DCC 3-1-1-2 requires EVIDENCE of disposal, not a statement that it occurred.",
          "required": [
            "at",
            "method",
            "signer"
          ],
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "method": {
              "type": "string"
            },
            "signer": {
              "$ref": "#/$defs/identity"
            },
            "recordDigests": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        "releasedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sha512": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      }
    },
    "resourceDescriptor": {
      "$comment": "in-toto ResourceDescriptor. At least one of uri, digest, content. content SHOULD be <1KB.",
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "uri"
          ]
        },
        {
          "required": [
            "digest"
          ]
        },
        {
          "required": [
            "content"
          ]
        }
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "content": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "downloadLocation": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "keyid"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string"
        },
        "keyid": {
          "type": "string",
          "minLength": 1,
          "$comment": "Informational only. DSSE states keyid MUST NOT be used for security decisions; trust comes from signature verification against the trusted key set."
        },
        "role": {
          "type": "string",
          "$comment": "Profile-supplied role name, e.g. Authorizing Official. Never hard-coded."
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "tier",
        "basis"
      ],
      "properties": {
        "scheme": {
          "type": "string"
        },
        "tier": {
          "type": "string"
        },
        "sensitivity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "basis": {
          "type": "string",
          "enum": [
            "assigned",
            "inherited-from-system",
            "default-on-silence",
            "highest-in-set"
          ]
        }
      }
    }
  }
}