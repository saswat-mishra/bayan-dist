{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bayan.dev/schemas/acceptance/v1",
  "type": "object",
  "required": [
    "schema",
    "pack",
    "standard",
    "rosterProcess",
    "skills",
    "gateBuild",
    "digest"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "const": "bayan.acceptance.v1"
    },
    "pack": {
      "type": "object",
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "standard": {
      "type": "object",
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "rosterProcess": {
      "type": "object",
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "bundleDigest"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "bundleDigest": {
            "type": "string"
          }
        }
      }
    },
    "gateBuild": {
      "type": "object",
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "acceptedBy": {
      "type": "object",
      "required": [
        "principal",
        "authority",
        "keyid",
        "at"
      ],
      "properties": {
        "principal": {
          "type": "string"
        },
        "authority": {
          "type": "string"
        },
        "keyid": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      }
    },
    "signature": {
      "type": "string"
    }
  }
}
